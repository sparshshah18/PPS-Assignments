#include <stdio.h>

struct Student {
    int roll;
    char name[50];
    float m1, m2, m3;
    float total;
    float percentage;
};

int main() {
    struct Student s[50];
    int n, i;

    printf("Enter number of students: ");
    scanf("%d", &n);

    for (i = 0; i < n; i++) {
        printf("\nEnter details of student %d:\n", i + 1);
        printf("Roll number: ");
        scanf("%d", &s[i].roll);
        printf("Name: ");
        scanf("%s", s[i].name);
        printf("Enter marks in 3 subjects: ");
        scanf("%f %f %f", &s[i].m1, &s[i].m2, &s[i].m3);

        s[i].total = s[i].m1 + s[i].m2 + s[i].m3;
        s[i].percentage = (s[i].total / 300.0f) * 100.0f;
    }

    printf("\n--- Student Results ---\n");
    for (i = 0; i < n; i++) {
        printf("Roll: %d | Name: %s | Total: %.2f | Percentage: %.2f%%\n",
               s[i].roll, s[i].name, s[i].total, s[i].percentage);
    }

    return 0;
}
